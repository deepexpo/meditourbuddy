# Supabase Postgres connection string.
# Use the "Session pooler" connection string from
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI.
# (The direct db.<ref>.supabase.co host is IPv6-only and won't resolve on most networks.)
# URL-encode any special characters in the password (e.g. # -> %23).
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"
