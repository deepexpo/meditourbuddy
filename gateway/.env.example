# --- Auth ---
# Generate a strong random secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- MCP server (clinic-registry-mcp) ---
# Command used to launch the MCP server as a subprocess (stdio transport).
# Swap this for your real MCP server's command/args, or switch mcp_client.py
# to the HTTP/SSE client if your server is remote.
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=example_mcp_server.py

# --- Databases ---
# Registry DB used by the MCP server subprocess above (clinics/procedures/
# pricing) — the gateway never queries this directly.
DATABASE_URL=postgresql://...

# Gateway DB (users/cases/reports), owned by this app. Leave unset to reuse
# DATABASE_URL (same Supabase instance, separate `gateway` schema — see
# `migrations/`). Only set this if the gateway DB ever moves elsewhere.
# GATEWAY_DATABASE_URL=

# --- Agent orchestration ---
ANTHROPIC_API_KEY=
# Hard timeout (seconds) for a single POST /cases agent run.
CASE_TIMEOUT_SECONDS=60

# --- CORS ---
# Comma-separated list of origins allowed to call this API (add your future
# web app's domain here, e.g. https://app.yourdomain.com)
ALLOWED_ORIGINS=http://localhost:3000
