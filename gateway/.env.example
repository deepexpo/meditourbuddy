# --- Auth ---
# Generate a strong random secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=8

# --- Password reset (email via Resend, https://resend.com) ---
# Get an API key from the Resend dashboard. Without this set, password
# reset requests are logged but no email is sent (still returns 204).
RESEND_API_KEY=
# Resend's shared test domain works with no setup; swap for a verified
# custom domain before real users depend on this.
RESEND_FROM_EMAIL=MediTourBuddy <onboarding@resend.dev>
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_REQUESTS_PER_HOUR=5

# --- MCP server (clinic-registry-mcp) ---
# Command used to launch the MCP server as a subprocess (stdio transport).
# The clinic-registry-mcp package is compiled TypeScript — it must be run
# with `node`, not `python`. Build it first: cd packages/clinic-registry-mcp && pnpm build
# To use a remote MCP server instead, switch mcp_client.py to the HTTP/SSE client.
MCP_SERVER_COMMAND=node
MCP_SERVER_ARGS=/absolute/path/to/meditourbuddy/packages/clinic-registry-mcp/dist/index.js

# --- Databases ---
# Registry DB used by the MCP server subprocess above (clinics/procedures/
# pricing) — the gateway never queries this directly.
DATABASE_URL=postgresql://...

# Gateway DB (users/cases/reports), owned by this app. Leave unset to reuse
# DATABASE_URL (same Supabase instance, separate `gateway` schema — see
# `migrations/`). Only set this if the gateway DB ever moves elsewhere.
# GATEWAY_DATABASE_URL=

# --- Agent orchestration ---
ANTHROPIC_API_KEY=
# Hard timeout (seconds) for a single POST /cases agent run.
CASE_TIMEOUT_SECONDS=60

# --- CORS ---
# Comma-separated list of origins allowed to call this API (add your future
# web app's domain here, e.g. https://app.yourdomain.com)
ALLOWED_ORIGINS=http://localhost:3000
